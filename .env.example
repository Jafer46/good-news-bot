# --- Telegram user account (used to READ the source channel) ---
# Get these from https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# Generated once by running generate_session.py locally (see README)
TELEGRAM_SESSION=

# Username of the channel you're pulling news from (no @, no t.me/)
SOURCE_CHANNEL=tikvahethiopia

# --- Telegram BOT account (used to POST to your own channel) ---
# Get this from @BotFather
TELEGRAM_BOT_TOKEN=123456:your-bot-token

# Your destination channel. Add the bot as admin there first.
# Can be @yourchannelusername or a numeric chat id like -1001234567890
DEST_CHANNEL_ID=@GoodNewsEthiopia

# --- Gemini (free tier) ---
# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Minimum confidence (0-1) required before auto-posting
GOOD_NEWS_CONFIDENCE_THRESHOLD=0.75
